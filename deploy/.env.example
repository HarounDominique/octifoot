# Copy to deploy/.env and replace every value marked CHANGE. Never commit deploy/.env.

# --- Dependencies ---
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=CHANGE_ME
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=CHANGE_ME
ELASTIC_MEMORY_SIZE=4G

# --- OpenCTI ---
OPENCTI_PORT=8080
OPENCTI_ADMIN_EMAIL=admin@example.org
OPENCTI_ADMIN_PASSWORD=CHANGE_ME
OPENCTI_ADMIN_TOKEN=CHANGE_ME_UUIDV4              # uuidgen
OPENCTI_HEALTHCHECK_ACCESS_KEY=CHANGE_ME
OPENCTI_ENCRYPTION_KEY=CHANGE_ME_BASE64           # openssl rand -base64 32

# --- SpiderFoot connector ---
CONNECTOR_SPIDERFOOT_ID=CHANGE_ME_UUIDV4          # uuidgen, must be unique
# REQUIRED. Comma-separated domains you are AUTHORIZED to investigate (subdomains included).
SPIDERFOOT_ALLOWED_DOMAINS=
SPIDERFOOT_TIMEOUT_SECONDS=900
# lean (default with the passive use case) or full. lean skips modules that only feed discarded
# co-host/affiliate data; imported objects were identical in the A/B. Set full for every module.
SPIDERFOOT_PROFILE=lean
# Address of the SpiderFoot UI as YOUR BROWSER reaches it (not the internal SPIDERFOOT_URL). Every object and Note
# links to the full scan there. Empty = no links. The UI has no authentication: keep it bound to localhost.
SPIDERFOOT_UI_URL=http://localhost:5001
# Automatic re-analysis. 0 = off (default). Otherwise 5..10080 minutes: domains you label `octifoot:watch` in OpenCTI
# (and that are on the allowlist) are re-analysed by the connector whenever their last scan is older than this, at most
# WATCH_MAX_PER_CYCLE scans per cycle. Each run is an ordinary enrichment work item.
SPIDERFOOT_WATCH_INTERVAL_MINUTES=0
SPIDERFOOT_WATCH_MAX_PER_CYCLE=3
# Optional free API keys for keyed SpiderFoot modules (see docs/api-keys.md). Empty = none. Example:
# SPIDERFOOT_API_KEYS_FILE=/run/octifoot-secrets/api-keys.json
SPIDERFOOT_API_KEYS_FILE=
# Control panel (add authorised domains and change the maximum time from a web page at http://localhost:8099). Off unless a token
# is set. Make a token with:  openssl rand -hex 24   It is the only thing protecting the page that decides what may be scanned.
OCTIFOOT_UI_TOKEN=
OCTIFOOT_UI_PORT=8099
OCTIFOOT_UI_LANG=en
SPIDERFOOT_SCORE=30
# Iterative expansion: 0 = off (one scan). 1-3 also scans discovered subdomains that are on the
# allowlist, breadth-first, at most SPIDERFOOT_MAX_SCANS scans per request (1-20, root included).
SPIDERFOOT_MAX_DEPTH=0
SPIDERFOOT_MAX_SCANS=5
