# Copy to deploy/.env and replace every value marked CHANGE. Never commit deploy/.env.

# --- Dependencies ---
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=CHANGE_ME
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=CHANGE_ME
ELASTIC_MEMORY_SIZE=4G

# --- OpenCTI ---
OPENCTI_PORT=8080
OPENCTI_ADMIN_EMAIL=admin@example.org
OPENCTI_ADMIN_PASSWORD=CHANGE_ME
OPENCTI_ADMIN_TOKEN=CHANGE_ME_UUIDV4              # uuidgen
OPENCTI_HEALTHCHECK_ACCESS_KEY=CHANGE_ME
OPENCTI_ENCRYPTION_KEY=CHANGE_ME_BASE64           # openssl rand -base64 32

# --- SpiderFoot connector ---
CONNECTOR_SPIDERFOOT_ID=CHANGE_ME_UUIDV4          # uuidgen, must be unique
# REQUIRED. Comma-separated domains you are AUTHORIZED to investigate (subdomains included).
SPIDERFOOT_ALLOWED_DOMAINS=
SPIDERFOOT_TIMEOUT_SECONDS=900
# full (default) or lean. lean skips modules that only feed discarded co-host/affiliate data.
SPIDERFOOT_PROFILE=full
SPIDERFOOT_SCORE=30
# Iterative expansion: 0 = off (one scan). 1-3 also scans discovered subdomains that are on the
# allowlist, breadth-first, at most SPIDERFOOT_MAX_SCANS scans per request (1-20, root included).
SPIDERFOOT_MAX_DEPTH=0
SPIDERFOOT_MAX_SCANS=5
